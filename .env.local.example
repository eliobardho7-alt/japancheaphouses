# Supabase - Database for blogs, listings, bookings, etc.
# Get these from https://supabase.com after creating a project
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe - Subscription payments ($5/month community)
# Get these from https://stripe.com after creating an account
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_subscription_price_id

# Resend - Email notifications for bookings & contact form
# Free tier: 100 emails/day. Get key at https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# Site URL (change in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your contact/admin email
NEXT_PUBLIC_CONTACT_EMAIL=eliobardho7@gmail.com
